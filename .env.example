# Default path: local Ollama. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window sent to Ollama. The sample suite fits easily inside 8192.
OLLAMA_NUM_CTX=8192

# ollama (default) or openai (any OpenAI-compatible /chat/completions server).
PROMPT_EVAL_PROVIDER=ollama

# Seconds to wait for each model call (the case, and the judge when it runs).
PROMPT_EVAL_TIMEOUT=120

# Optional OpenAI-compatible path. Used only when PROMPT_EVAL_PROVIDER=openai.
# api.openai.com requires OPENAI_API_KEY. A local compatible server may omit it.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
